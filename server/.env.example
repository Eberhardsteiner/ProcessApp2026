ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
PROXY_SHARED_SECRET=

# --- Transkriptions-Proxy (server/transcriptionProxy.mjs, eigener Prozess/Port) ---
# Hinweis: PORT/ALLOWED_ORIGIN/PROXY_SHARED_SECRET oben gelten pro Prozess.
# Wird der Transkriptions-Proxy in derselben Shell/.env gestartet, setzen Sie PORT
# vorher auf den Transkriptions-Port (z. B. 8788) bzw. nutzen Sie eine eigene .env.
# Pflicht: OpenAI-kompatible /audio/transcriptions-URL (self-hosted Whisper ODER OpenAI)
TRANSCRIPTION_ENDPOINT=
# Optional: ausgehender Bearer an die Gegenstelle (lokal oft leer; bei OpenAI = API-Key)
TRANSCRIPTION_API_KEY=
# Modellname für die Gegenstelle
TRANSCRIPTION_MODEL=whisper-1
# Optional: eingehender Bearer (Browser -> Proxy); darf demselben Wert wie PROXY_SHARED_SECRET entsprechen
TRANSCRIPTION_PROXY_SHARED_SECRET=
# Upstream-Timeout in ms (Audio darf länger dauern als Text)
TRANSCRIPTION_TIMEOUT_MS=60000
